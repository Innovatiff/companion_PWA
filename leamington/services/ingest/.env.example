# Postgres (Supabase connection string, or PG* vars)
DATABASE_URL=postgresql://user:pass@host:5432/leamington

# Where owner alerts are delivered when a feed goes quiet.
# Without this, staleness is logged but nobody is paged.
OWNER_ALERT_WEBHOOK=https://hooks.example.com/...

# Optional API keys. Feeds needing an absent key are SKIPPED, not failed.
OPENWEATHER_KEY=
WEATHERAPI_KEY=
API_FOOTBALL_KEY=

# Tuning
LOG_LEVEL=info
ALERT_FETCH_LIMIT=25
RENOTIFY_AFTER_MS=21600000
PORT=3000
