# Postgres (Supabase connection string, or PG* vars)
DATABASE_URL=postgresql://user:pass@host:5432/leamington

# Where owner alerts are delivered when a feed goes quiet. Missing, or failing
# to deliver, makes /health critical. For Telegram use the Bot API URL:
#   https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat id>
# or leave chat_id off and set OWNER_ALERT_TELEGRAM_CHAT_ID. Any other URL is
# POSTed the alert as JSON.
OWNER_ALERT_WEBHOOK=https://hooks.example.com/...
OWNER_ALERT_TELEGRAM_CHAT_ID=

# Optional API keys. Feeds needing an absent key are SKIPPED, not failed.
OPENWEATHER_KEY=
WEATHERAPI_KEY=
API_FOOTBALL_KEY=

# Tuning
LOG_LEVEL=info
ALERT_FETCH_LIMIT=25
RENOTIFY_AFTER_MS=21600000
PORT=3000
