# Our Postgres (Supabase). Server side only; the browser never sees it.
DATABASE_URL=postgresql://user:pass@host:6543/postgres

# Signs the session cookie. At least 32 random characters. Shared by all three
# apps; the cookie is bound to this portal, so it is useless on the others.
SESSION_SECRET=

# Leave unset in production (cookies are Secure). Set to false only for local
# plain-http testing.
COOKIE_SECURE=

# Optional. The address of Hoy printed on the client's code slip, e.g. hoy.example.com
HOY_URL=
