# Our Postgres (Supabase). Server side only; the browser never sees it.
DATABASE_URL=postgresql://user:pass@host:6543/postgres

# Signs the session cookie. At least 32 random characters. The same value as
# the other two apps: the cookie's signature is bound to its portal, so an
# affiliate cookie is still worthless here.
SESSION_SECRET=

# Leave unset in production (cookies are Secure). Set to false only for local
# plain-http testing.
COOKIE_SECURE=

# Base URLs used to build one-time setup links.
ADMIN_URL=http://localhost:3300
AFFILIATE_URL=http://localhost:3200
