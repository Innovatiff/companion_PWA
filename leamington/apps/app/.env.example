# Our Postgres (Supabase). Server side only; the browser never sees it.
DATABASE_URL=postgresql://user:pass@host:6543/postgres

# Signs the session cookie. At least 32 random characters, e.g.
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# Changing it signs everyone out; they sign in again with their code.
SESSION_SECRET=

# Leave unset in production (cookies are Secure). Set to false only for local
# plain-http testing on a non-localhost address.
COOKIE_SECURE=
